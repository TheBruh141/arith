let add = \x: Int -> \y: Int -> x + y in
assert (add 10 20 == 30);

let rec factorial = \n: Int ->
  if n <= 1 then 1 else n * factorial (n - 1)
in
assert (factorial 0 == 1);
assert (factorial 1 == 1);
assert (factorial 5 == 120);

let make_adder = \x: Int -> \y: Int -> x + y in
let add5 = make_adder 5 in
assert (add5 10 == 15);
assert (add5 0 == 5);

let rec fib = \n: Int ->
  if n <= 1 then n else fib (n - 1) + fib (n - 2)
in
assert (fib 0 == 0);
assert (fib 1 == 1);
assert (fib 5 == 5);
assert (fib 10 == 55);
